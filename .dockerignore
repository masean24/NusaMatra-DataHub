# Git & version control
.git
.gitignore

# Python cache & virtual environments
__pycache__
*.py[cod]
*$py.class
.venv/
env/
venv/

# Testing & Coverage
tests/
.pytest_cache/
.coverage
htmlcov/

# Local database (will be seeded freshly during build)
data/*.db
data/*.db-wal
data/*.db-shm

# Raw source snapshots (large PDFs/HTML/JSON; derived CSVs are kept)
data/raw/
data/boundaries/hdx_*
data/boundaries/big_*
data/boundaries/*.gz

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
